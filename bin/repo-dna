#!/usr/bin/env bash

# Resolve script location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
JAR_FILE=$(ls "$ROOT_DIR"/build/libs/*-all.jar 2>/dev/null | head -n 1)

# Check if JAR exists
if [ -z "$JAR_FILE" ] || [ ! -f "$JAR_FILE" ]; then
    echo "Error: RepoDNA executable JAR not found in $ROOT_DIR/build/libs/"
    echo "Please build it first by running: cd $ROOT_DIR && ./gradlew shadowJar"
    exit 1
fi

# Execute the JAR with all arguments passed through
exec java -jar "$JAR_FILE" "$@"
